name: Deploy to VPS via SSH
        uses: appleboy/ssh-action@v1.0.3
        env:
          GHCR_PAT: ${{ secrets.GHCR_PAT }}
          GHCR_USER: ${{ github.actor }}
          DEPLOY_TAG: ${{ steps.vars.outputs.sha }}
          ENV_FILE: ${{ secrets.ENV_FILE }}
        with:
          host: ${{ secrets.VPS_HOST }}
          username: ${{ secrets.VPS_USERNAME }}
          key: ${{ secrets.VPS_SSH_KEY }}
          envs: GHCR_PAT,GHCR_USER,DEPLOY_TAG,ENV_FILE
          script: |
            mkdir -p /opt/paperclip
            cd /opt/paperclip
            if [ ! -d ".git" ]; then
              git clone -b production https://github.com/robertteah/paperclip.git .
            else
              git fetch origin production
              git checkout production
              git pull origin production
            fi

            # Inject runtime secrets to .env before starting containers
            if [ -n "$ENV_FILE" ]; then
              echo "$ENV_FILE" > .env
              chmod 600 .env
            fi

            chmod +x deploy/vps-deploy.sh
            ./deploy/vps-deploy.sh "$DEPLOY_TAG"
on:
  push:
    branches:
      - production

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Log in to GHCR
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GHCR_PAT }}

      - name: Set Commit Hash
        id: vars
        run: echo "sha=$(git rev-parse --short HEAD)" >> $GITHUB_OUTPUT

      - name: Build and push Paperclip
        uses: docker/build-push-action@v5
        with:
          context: .
          file: ./Dockerfile
          push: true
          tags: |
            ghcr.io/${{ github.repository_owner }}/paperclip:${{ steps.vars.outputs.sha }}
            ghcr.io/${{ github.repository_owner }}/paperclip:latest

      - name: Deploy to VPS via SSH
        uses: appleboy/ssh-action@v1.0.3
        env:
          GHCR_PAT: ${{ secrets.GHCR_PAT }}
          GHCR_USER: ${{ github.actor }}
          DEPLOY_TAG: latest
        with:
          host: ${{ secrets.VPS_HOST }}
          username: ${{ secrets.VPS_USERNAME }}
          key: ${{ secrets.VPS_SSH_KEY }}
          envs: GHCR_PAT,GHCR_USER,DEPLOY_TAG
          script: |
            mkdir -p /opt/paperclip
            cd /opt/paperclip
            if [ ! -d ".git" ]; then
              git clone -b production https://github.com/robertteah/paperclip.git .
            else
              git fetch origin production
              git checkout production
              git pull origin production
            fi
            chmod +x deploy/vps-deploy.sh
            ./deploy/vps-deploy.sh "$DEPLOY_TAG"
